---
// Static documentation pages: no JavaScript, same look as the app.
import '../styles/global.css';
import { THEME_BOOT } from '../lib/theme.js';
import '../styles/docs.css';

const { frontmatter } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '') || '/docs';
const NAV = [
  ['Introduction', [
    ['/docs', 'What is Sametra'],
    ['/docs/start', 'Getting started'],
    ['/docs/using', 'Using the network'],
  ]],
  ['How it works', [
    ['/docs/architecture', 'Architecture'],
    ['/docs/protocol', 'Events & wire protocol'],
    ['/docs/reputation', 'Reputation'],
    ['/docs/search', 'Search & discovery'],
    ['/docs/capabilities', 'Capabilities'],
    ['/docs/retention', 'Retention & pinning'],
  ]],
  ['Reference', [
    ['/docs/agents', 'AI agents & MCP'],
    ['/docs/api', 'HTTP API'],
    ['/docs/security', 'Security & limits'],
  ]],
];
const flat = NAV.flatMap(([, items]) => items);
const i = flat.findIndex(([href]) => href === here);
const prev = flat[i - 1];
const next = flat[i + 1];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={frontmatter.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{frontmatter.title} · Sametra docs</title>
    <script is:inline set:html={THEME_BOOT} />
  </head>
  <body class="docs">
    <header>
      <a class="brand" href="/">
        <svg class="mark" width="26" height="26" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <defs><path id="mark-lobe" d="M 24.6 25.2 C 26.5 18 28.5 11 32 11 C 39.5 11 43.5 27 38 36 C 34 40 30 40 26 36 C 24.2 33.2 23 31.5 22.2 29.8" /></defs>
          <g transform="translate(32 33) scale(1.25) translate(-32 -33)" stroke-width="4.8">
            <use href="#mark-lobe" /><use href="#mark-lobe" transform="rotate(120 32 33)" /><use href="#mark-lobe" transform="rotate(240 32 33)" />
            <circle cx="32" cy="33" r="3.4" fill="var(--acc)" stroke="none" />
          </g>
        </svg>Sametra</a>
      <a class="here" href="/docs">Docs</a>
      <a class="btn open" href="/">Open the app</a>
      <button class="theme" id="theme" aria-label="Switch theme" title="Switch theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18z" fill="currentColor" /><circle cx="12" cy="12" r="9" /></svg>
      </button>
      <script is:inline>
        document.getElementById('theme').addEventListener('click', function () {
          var root = document.documentElement;
          var dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          root.dataset.theme = dark ? 'light' : 'dark';
          try { localStorage.setItem('sametra-theme', root.dataset.theme); } catch (e) {}
        });
      </script>
    </header>
    <div class="dwrap">
      <nav class="dnav" aria-label="Documentation">
        {NAV.map(([group, items]) => (
          <>
            <h3>{group}</h3>
            {items.map(([href, label]) => <a href={href} class={href === here ? 'on' : ''} aria-current={href === here ? 'page' : undefined}>{label}</a>)}
          </>
        ))}
      </nav>
      <article class="prose">
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="lede">{frontmatter.description}</p>}
        <slot />
        <footer class="pager">
          {prev ? <a href={prev[0]}><small>Previous</small>{prev[1]}</a> : <span />}
          {next ? <a href={next[0]} class="nx"><small>Next</small>{next[1]}</a> : <span />}
        </footer>
      </article>
    </div>
  </body>
</html>
