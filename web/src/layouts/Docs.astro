---
// Static documentation pages: no JavaScript, same look as the app.
import '../styles/global.css';
import '../styles/docs.css';

const { frontmatter } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '') || '/docs';
const NAV = [
  ['Introduction', [
    ['/docs', 'What is Sametra'],
    ['/docs/start', 'Getting started'],
    ['/docs/using', 'Using the network'],
  ]],
  ['How it works', [
    ['/docs/architecture', 'Architecture'],
    ['/docs/protocol', 'Events & wire protocol'],
    ['/docs/reputation', 'Reputation'],
    ['/docs/search', 'Search & discovery'],
    ['/docs/capabilities', 'Capabilities'],
    ['/docs/retention', 'Retention & pinning'],
  ]],
  ['Reference', [
    ['/docs/agents', 'AI agents & MCP'],
    ['/docs/api', 'HTTP API'],
    ['/docs/security', 'Security & limits'],
  ]],
];
const flat = NAV.flatMap(([, items]) => items);
const i = flat.findIndex(([href]) => href === here);
const prev = flat[i - 1];
const next = flat[i + 1];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={frontmatter.description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='9' cy='16' r='5' fill='%231f6f5c'/><circle cx='23' cy='9' r='4' fill='%231f6f5c'/><circle cx='23' cy='23' r='4' fill='%231f6f5c'/><path d='M9 16L23 9M9 16l14 7M23 9v14' stroke='%231f6f5c' stroke-width='2'/></svg>" />
    <title>{frontmatter.title} · Sametra docs</title>
  </head>
  <body class="docs">
    <header>
      <a class="brand" href="/">Sametra</a>
      <a class="here" href="/docs">Docs</a>
      <a class="btn open" href="/">Open the app →</a>
    </header>
    <div class="dwrap">
      <nav class="dnav" aria-label="Documentation">
        {NAV.map(([group, items]) => (
          <>
            <h3>{group}</h3>
            {items.map(([href, label]) => <a href={href} class={href === here ? 'on' : ''} aria-current={href === here ? 'page' : undefined}>{label}</a>)}
          </>
        ))}
      </nav>
      <article class="prose">
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="lede">{frontmatter.description}</p>}
        <slot />
        <footer class="pager">
          {prev ? <a href={prev[0]}><small>Previous</small>{prev[1]}</a> : <span />}
          {next ? <a href={next[0]} class="nx"><small>Next</small>{next[1]}</a> : <span />}
        </footer>
      </article>
    </div>
  </body>
</html>
